# ── Inithan Custom Gifts Backend Environment Configuration ──

# Server Configuration
PORT=8081
NODE_ENV=development
APP_URL=https://inithancustomgifts.com
CLIENT_URL=https://inithancustomgifts.com

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/inithan_gifts?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=inithan_custom_gifts_jwt_secret_key_2026

# ── Meta WhatsApp Cloud API Credentials ─────────────────────────────────────
# 1. WhatsApp Permanent Access Token (From Meta Business Manager -> System Users)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# 2. WhatsApp Business Phone Number ID (From Meta Developer Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 3. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id_here

# 4. Meta Webhook Verification Token (Matches value in Meta Webhook configuration)
WHATSAPP_VERIFY_TOKEN=inithan_wa_verify_token_2026

# 5. Meta Graph API Version (Default: v21.0)
WHATSAPP_API_VERSION=v21.0

# 6. Approved WhatsApp OTP Message Template Name (From WhatsApp Manager -> Message Templates)
# Example: inithan_auth_otp
WHATSAPP_OTP_TEMPLATE_NAME=inithan_auth_otp

# 7. Approved WhatsApp Order Confirmation Template Name (Optional, uses text fallback if omitted)
# Example: inithan_order_confirmation
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE_NAME=inithan_order_confirmation

# 8. Approved WhatsApp Order Cancellation Template Name (Optional, uses text fallback if omitted)
# Example: inithan_order_cancellation
WHATSAPP_ORDER_CANCELLATION_TEMPLATE_NAME=inithan_order_cancellation

# 9. Template Language Code (e.g., en_US, en)
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# ── AWS S3 Storage (Optional / File Uploads) ──────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=inithan-custom-gifts-prod-651484323514-eu-north-1-an

# ── Razorpay Payment Gateway (Optional) ──────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

